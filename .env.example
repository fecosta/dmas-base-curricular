# Browser-safe project configuration. Use a publishable key (or local anon key).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-anon-or-project-publishable-key
# Application-owned origin used to build the fixed OAuth callback URL.
APP_URL=http://127.0.0.1:3000
# No service-role / secret key is used by the application.
