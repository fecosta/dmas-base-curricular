# Browser-safe project configuration. Use a publishable key (or local anon key).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-anon-or-project-publishable-key
# Application-owned origin used to build the fixed OAuth callback URL.
APP_URL=http://127.0.0.1:3000
# Used only by the server-only Auth Admin boundary; never expose in a NEXT_PUBLIC_* variable.
SUPABASE_AUTH_ADMIN_SECRET_KEY=sb_secret_replace-with-local-key
# Optional external feedback form URL (SPEC-010 U5 / D-035). Must be an absolute
# https: URL without embedded credentials. The feedback action is inert and
# renders nothing when this is unset, empty, whitespace-only, or invalid. No
# query parameters, identity or context are appended.
# NEXT_PUBLIC_FEEDBACK_FORM_URL=https://forms.example.com/replace-with-approved-url
#
# NOTE: NEXT_PUBLIC_* variables are inlined at `next build` time. Changing,
# enabling, or disabling NEXT_PUBLIC_FEEDBACK_FORM_URL requires a rebuild and
# redeploy.

# Optional product analytics (SPEC-008). Browser-safe PostHog *project* key only
# (phc_...); a personal/private key (phx_/phs_) is rejected. Leave unset outside
# Production: analytics is a no-op unless NEXT_PUBLIC_VERCEL_ENV is exactly
# "production" AND the authenticated user's affirmative preference is persisted.
# NEXT_PUBLIC_POSTHOG_KEY=phc_replace-with-posthog-cloud-eu-project-key
